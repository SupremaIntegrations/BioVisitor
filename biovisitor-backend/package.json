{
  "name": "biovisitor-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "build:exe": "npm run build && npx @yao-pkg/pkg dist/main.js -c package.json --target node24-win-x64 --output release/biovisitor-backend.exe",
    "build:exe:linux": "npm run build && npx @yao-pkg/pkg dist/main.js -c package.json --target node24-linux-x64 --output release/biovisitor-backend-linux",
    "build:exe:mac": "npm run build && npx @yao-pkg/pkg dist/main.js -c package.json --target node24-macos-x64 --output release/biovisitor-backend-macos"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.2.2",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bullmq": "^5.81.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-writer": "^1.6.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nest-winston": "^1.10.2",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.31",
    "uuid": "^13.0.2",
    "winston": "^3.19.0"
  },
  "pkg": {
    "assets": [
      "dist/modules/notifications/templates/**/*.hbs",
      "dist/i18n/**/*",
      "node_modules/pdfkit/js/data/**",
      "node_modules/pdfkit/js/font/**",
      "node_modules/bcrypt/prebuilds/win32-x64/**/*.node",
      "node_modules/@img/sharp-win32-x64/**",
      "node_modules/ansis/**/*",
      "node_modules/typeorm/node_modules/ansis/**/*",
      "node_modules/@nestjs-modules/mailer/dist/**/*.js"
    ],
    "scripts": [
      "dist/**/*.js"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^3.15.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^7.0.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
