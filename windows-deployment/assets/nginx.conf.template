# ============================================================
#  BioVisitor X — nginx config (reemplaza server-https.js)
#  Generado por el instalador — no editar a mano en producción,
#  usar el BioVisitor Admin Tool para cambiar puertos.
#
#  Placeholders sustituidos en la instalación:
#    {{PORT_HTTPS}}   Puerto HTTPS público (default 443)
#    {{PORT_HTTP}}    Puerto HTTP, solo redirige a HTTPS (default 80)
#    {{PORT_API}}     Puerto del backend NestJS (default 3001)
#    {{INSTALL_DIR}}  Directorio de instalación, con "/" en vez de "\"
#                      (nginx en Windows recomienda "/" para evitar
#                      problemas de escape con la barra invertida)
# ============================================================

worker_processes  1;
pid                "{{INSTALL_DIR}}/nginx/nginx.pid";

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    access_log  "{{INSTALL_DIR}}/logs/frontend/nginx-access.log";
    error_log   "{{INSTALL_DIR}}/logs/frontend/nginx-error.log";

    # ── HTTP: solo redirige a HTTPS ────────────────────────────────────
    server {
        listen {{PORT_HTTP}};
        return 301 https://$host:{{PORT_HTTPS}}$request_uri;
    }

    # ── HTTPS: SPA estático + proxy al backend ─────────────────────────
    server {
        listen {{PORT_HTTPS}} ssl;

        ssl_certificate      "{{INSTALL_DIR}}/frontend/cert/server.crt";
        ssl_certificate_key  "{{INSTALL_DIR}}/frontend/cert/server.key";

        root   "{{INSTALL_DIR}}/frontend/out";
        index  index.html;

        client_max_body_size 10m;

        # API → backend (mismas reglas que las rewrites() que tenía next.config.ts)
        location /api/v1/ {
            proxy_pass http://127.0.0.1:{{PORT_API}}/api/v1/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # WebSocket (Socket.IO) → backend
        location /socket.io/ {
            proxy_pass http://127.0.0.1:{{PORT_API}}/socket.io/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
        }

        # ── SPA fallback por cada ruta de token dinámico ───────────────
        # `next build` (output: 'export', sin trailingSlash) genera un
        # único archivo plano <ruta>.html por cada una de estas rutas
        # (ej: out/visitor/onboarding.html) — se sirve ESE archivo para
        # cualquier token bajo el prefijo, sin redirigir al navegador, así
        # que los enlaces de QR/correo ya emitidos (con el token en la URL)
        # siguen funcionando sin cambios en el backend.
        location ^~ /visitor/onboarding/ { try_files $uri /visitor/onboarding.html; }
        location ^~ /visitor/survey/     { try_files $uri /visitor/survey.html; }
        location ^~ /visitor/false-exit/ { try_files $uri /visitor/false-exit.html; }
        location ^~ /visitor/qr/         { try_files $uri /visitor/qr.html; }
        location ^~ /pre-register/       { try_files $uri /pre-register.html; }

        # ── Todo lo demás: archivos estáticos normales ─────────────────
        # (/, /dashboard/**, /auth/reset-password, JS/CSS/imágenes, etc.)
        location / {
            try_files $uri $uri.html $uri/ /index.html;
        }

        error_page 404 /404.html;
    }
}
