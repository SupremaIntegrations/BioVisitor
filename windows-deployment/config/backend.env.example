# ============================================================
#  Suprema LATAM BioVisitor — Backend Environment Variables
#  Copiar a: %PROGRAMFILES%\SupremaLATAM\BioVisitor\backend\.env
#  y completar cada valor marcado con CAMBIAR_ antes de instalar.
# ============================================================

NODE_ENV=production
APP_PORT=3001

# ---- PostgreSQL ----
# BioVisitor se conecta con el superusuario "postgres" (no se crea un rol
# de aplicación aparte) — usa la misma contraseña que definiste al
# instalar PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_PASSWORD_DE_POSTGRES
DB_NAME=biovisitor_db

# ---- Redis ----
# Redis es REQUERIDO — se usa para QR tokens, caché de sesiones BioStar,
# configuración por tenant (auto-checkout, encuesta de salida),
# caché de grupos de acceso, y dispositivos enrolladores.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=    # Descomentar si Redis tiene contraseña

# ---- Seguridad / JWT ----
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_MINIMO_64_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---- Cifrado AES-256-GCM (credenciales BioStar) ----
# Debe ser exactamente 64 hex chars (32 bytes):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=CAMBIAR_64_CARACTERES_HEX

# ---- QR Engine ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
QR_JWT_SECRET=CAMBIAR_MINIMO_48_CARACTERES_ALEATORIOS
QR_EXPIRATION_MINUTES=5

# ---- URLs (HTTPS obligatorio) ----
FRONTEND_URL=https://192.168.1.100
CORS_ALLOWED_ORIGINS=https://192.168.1.100

# ---- Email SMTP (opcional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@empresa.com
SMTP_PASSWORD=CAMBIAR_APP_PASSWORD
SMTP_FROM_NAME=BioVisitor — Suprema LATAM
SMTP_FROM=notificaciones@empresa.com

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ---- Logging ----
LOG_LEVEL=warn
