# ============================================================
#  BioVisitor X — Frontend Environment Variables
#  El frontend corre en puerto 3000 INTERNAMENTE.
#  Nginx es el único punto de entrada público (443/80).
#
#  Estas variables se configuran via NSSM en el script
#  2-install-services.bat (no necesitan un archivo .env).
#  Este archivo es solo de referencia.
# ============================================================

# Puerto interno (Nginx proxea hacia aquí)
PORT=3000

# Solo escuchar en loopback (Nginx es el proxy público)
HOSTNAME=127.0.0.1

# Siempre producción en on-premise
NODE_ENV=production

# URL relativa — el navegador envía /api/v1/* a Nginx,
# que lo proxea al backend en :3001
NEXT_PUBLIC_API_URL=/api/v1
